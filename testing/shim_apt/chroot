#!/bin/bash
# pi_clean test shim: emulates 'chroot --userspec=U DIR CMD...' by running
# CMD (minus the fixed path) on the host, where a fake 'apt-get' on PATH
# supplies canned apt output. Logs every call for the assertions.
echo "CHROOT $*" >> "${SHIM_LOG:?}"
if [[ ${SHIM_FAILALL:-0} == 1 ]]; then
    echo 'E: chroot failed: Invalid argument' >&2
    exit 1
fi
shift            # --userspec=root:root
shift            # the (skeleton) base dir
shift            # /usr/bin/apt-get
exec apt-get "$@"
